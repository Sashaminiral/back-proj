        {
          "name": "List workshops (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('JSON со списком результатов', function () {",
                  "  pm.expect(json).to.have.property('results');",
                  "  pm.expect(json.results).to.be.an('array');",
                  "});",
                  "const future = json.results.find(item => item.title !== 'Прошедший мастер-класс');",
                  "const past = json.results.find(item => item.title === 'Прошедший мастер-класс');",
                  "if (future) { pm.collectionVariables.set('workshop_id', String(future.id)); }",
                  "if (past) { pm.collectionVariables.set('past_workshop_id', String(past.id)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/workshops/"
          }
        },
        {
          "name": "Retrieve workshop (public)",
