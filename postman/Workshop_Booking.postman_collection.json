        {
          "name": "Register user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 201', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Токен выдан, пароль не возвращается', function () {",
                  "  pm.expect(json.token).to.be.a('string').and.to.have.lengthOf.at.least(8);",
                  "  pm.expect(json.user).to.not.have.property('password');",
                  "  pm.expect(json.user).to.not.have.property('password_hash');",
                  "});",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('user_token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student_{{$timestamp}}\",\n  \"email\": \"student{{$timestamp}}@example.com\",\n  \"password\": \"StudentPass123\",\n  \"first_name\": \"Иван\",\n  \"last_name\": \"Студент\"\n}"
            },
            "url": "{{base_url}}/api/auth/register/"
          }
        },
